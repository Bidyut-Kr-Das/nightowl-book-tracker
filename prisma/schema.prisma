// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id Int @id @default(autoincrement())

  // External API reference
  hardcoverId Int?     @unique
  genres      String[] @default([])

  // Core metadata
  title       String
  subtitle    String?
  slug        String? @unique
  description String?
  headline    String?

  // Publishing
  releaseDate DateTime?
  // releaseYear Int?
  pages       Int?
  mood        String[]  @default([])

  // Media
  coverImage String?
  // headerImage String?

  // Ratings
  averageRating Float?
  ratingsCount  Int    @default(0)
  reviewsCount  Int    @default(0)

  indexInSeries String @default("0")

  // Categorization

  // Extra metadata
  tags String[]
  // links Json?

  // Relations
  authors Author[]
  series  Series[]
  reviews Review[]
  shelves UserBook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([slug])
  @@index([hardcoverId])
}

model Author {
  id Int @id @default(autoincrement())

  hardcoverId Int? @unique

  name  String
  bio   String?
  image String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hardcoverId])
}

model Series {
  id Int @id @default(autoincrement())

  hardcoverId Int? @unique

  name        String
  description String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hardcoverId])
}

model Review {
  id Int @id @default(autoincrement())

  userId Int
  bookId Int

  rating Float
  review String?

  spoiler Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
}

model UserBook {
  id Int @id @default(autoincrement())

  userId Int
  bookId Int

  status      ReadingStatus
  progress    Int? // current page
  bookImage   String?
  bookImageId String?

  startedAt  DateTime?
  finishedAt DateTime?

  rating Float?

  tags String? @default("")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId, bookId])
  @@index([status])
}

model User {
  id Int @id @default(autoincrement())

  name        String
  email       String @unique
  clerkUserId String @unique

  avatarId Int?
  Avatar   AvatarImages? @relation(fields: [avatarId], references: [id])

  shelves UserBook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  following      User[] @relation("UserFollows")
  followers      User[] @relation("UserFollows")
  

  @@index([clerkUserId])
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  // WISHLIST
  // OWNED
}

model AvatarImages {
  id        Int      @id @default(autoincrement())
  title     String?  @default("")
  url       String
  fileId    String?
  metaData  Json?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}
